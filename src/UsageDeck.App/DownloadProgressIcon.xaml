<UserControl
    x:Class="UsageDeck.App.DownloadProgressIcon"
    x:Name="IconRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="30"
    Height="30"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">
    <Viewbox>
        <Grid Width="30" Height="30">
            <Path
                x:Name="ProgressTrack"
                Data="M15,1 A14,14 0 0 1 15,29 A14,14 0 0 1 15,1"
                Stroke="{Binding Foreground, ElementName=IconRoot}"
                StrokeThickness="1.5"
                Visibility="Collapsed" />
            <Path
                Stroke="{Binding Foreground, ElementName=IconRoot}"
                StrokeThickness="1.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                x:Name="ProgressArc"
                Visibility="Collapsed">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="15,1" IsClosed="False">
                            <ArcSegment
                                x:Name="ProgressSegment"
                                Point="15,1"
                                Size="14,14"
                                SweepDirection="Clockwise" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <Path
                x:Name="DownloadArrow"
                Data="M12,4.5 V14.5 M7.5,10 L12,14.5 L16.5,10 M5.5,15 V18.5 Q5.5,19.5 6.5,19.5 H17.5 Q18.5,19.5 18.5,18.5 V15"
                Stroke="{Binding Foreground, ElementName=IconRoot}"
                StrokeThickness="1.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round">
                <Path.RenderTransform>
                    <TranslateTransform X="3" Y="3" />
                </Path.RenderTransform>
            </Path>
            <Ellipse
                x:Name="AvailableDot"
                Width="6"
                Height="6"
                Margin="0,5,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Fill="{Binding Foreground, ElementName=IconRoot}" />
        </Grid>
    </Viewbox>
</UserControl>
